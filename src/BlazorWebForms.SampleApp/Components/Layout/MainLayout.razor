@inherits LayoutComponentBase
@inject BlazorWebForms.Core.Abstractions.ICurrentUserContext CurrentUserContext
@inject NavigationManager Navigation
@inject AppLocalizer L
<a class="skip-link" href="#main-content">@L.Get("Layout.SkipToMain")</a>
<div class="app-shell">
    <aside class="app-sidebar" aria-label="Primary">
        <NavMenu />
    </aside>

    <main id="main-content" class="app-main" tabindex="-1">
        <div class="app-top-row">
            <span class="app-top-row-title">@L.Get("Layout.Title")</span>
            <div class="app-top-row-auth">
                <form method="get" action="/culture/set" class="app-auth-form app-culture-form" aria-label="@L.Get("Layout.Culture")">
                    <label class="visually-hidden" for="culture">@L.Get("Layout.Culture")</label>
                    <input type="hidden" name="returnUrl" value="@LocalReturnUrl" />
                    <select id="culture" class="app-auth-input" name="culture" @bind="SelectedCulture">
                        @foreach (var culture in SupportedCultureOptions)
                        {
                            <option value="@culture.Value">@culture.Label</option>
                        }
                    </select>
                    <button type="submit" class="app-auth-button">@L.Get("Layout.ApplyCulture")</button>
                </form>
                <span class="app-user-pill">@UserSummary</span>
                @if (CurrentUser.IsAuthenticated)
                {
                    <form method="post" action="/auth/logout">
                        <input type="hidden" name="returnUrl" value="@LocalReturnUrl" />
                        <button type="submit" class="app-auth-button">@L.Get("Layout.LogOut")</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/auth/login" class="app-auth-form">
                        <input type="hidden" name="returnUrl" value="@LocalReturnUrl" />
                        <input class="app-auth-input" type="text" name="user" value="casey.manager" />
                        <select class="app-auth-input" name="role">
                            <option value="Manager">Manager</option>
                            <option value="Owner">Owner</option>
                            <option value="Approver">Approver</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <button type="submit" class="app-auth-button">@L.Get("Layout.DevLogin")</button>
                    </form>
                }
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noopener noreferrer">@L.Get("Layout.Docs")</a>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private BlazorWebForms.Core.Models.UserProfile CurrentUser => CurrentUserContext.GetCurrentUser();

    private string UserSummary => CurrentUser.IsAuthenticated
        ? $"{CurrentUser.DisplayName} ({string.Join(", ", CurrentUser.Roles)})"
        : L.Get("Layout.UserAnonymous");

    private string SelectedCulture { get; set; } = System.Globalization.CultureInfo.CurrentUICulture.Name;

    private static IReadOnlyList<(string Value, string Label)> SupportedCultureOptions { get; } =
    [
        ("en-US", "English (US)"),
        ("fr-FR", "Francais"),
        ("es-ES", "Espanol"),
        ("ar-SA", "Arabic")
    ];

    private string LocalReturnUrl
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            return string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
        }
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
