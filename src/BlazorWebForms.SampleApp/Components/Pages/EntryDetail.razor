@page "/entries/{EntryId:guid}"
@attribute [Authorize(Policy = AuthPolicies.SelfViewAccess)]
@using System.Globalization
@inject FormsApplicationService FormsService
@inject EntryFileDownloadTokenService DownloadTokenService
@inject NavigationManager NavigationManager
@inject AppLocalizer L

<PageTitle>Entry Detail</PageTitle>

@if (!IsLoaded)
{
    <p role="status" aria-live="polite">@L.Get("Entry.Loading")</p>
}
else if (ViewModel is null)
{
    <section class="bwf-panel">
        <p class="bwf-kicker">Not found</p>
        <h1>@L.Get("Entry.NotFound")</h1>
        <p class="bwf-help">The entry was not found, or you do not have permission to view it.</p>
    </section>
}
else if (!ViewModel.CanView)
{
    <section class="bwf-panel">
        <p class="bwf-kicker">Access denied</p>
        <h1>@L.Get("Entry.AccessDenied")</h1>
        <p class="bwf-help">Only the submitter, assigned viewers, managers, owners, or admins can open this entry.</p>
    </section>
}
else
{
    <article class="entry-shell">
        <header class="entry-header">
            <div>
                <p class="eyebrow">Entry detail</p>
                <h1>@ViewModel.Form.Name</h1>
                <p>@ViewModel.Entry.SubmittedBy · @ViewModel.Entry.Status</p>
                <p>
                    <button class="bwf-button" @onclick="DownloadPdfAsync" disabled="@IsPdfLoading">
                        @(IsPdfLoading ? L.Get("Entry.GeneratingPdf") : L.Get("Entry.GeneratePdf"))
                    </button>
                </p>
                @if (!string.IsNullOrWhiteSpace(PdfStatusMessage))
                {
                    <p class="bwf-help" role="status" aria-live="polite">@PdfStatusMessage</p>
                }
            </div>
            <div class="metric-card">
                <span>Revisions</span>
                <strong>@ViewModel.Entry.Revisions.Count</strong>
            </div>
            <div class="metric-card">
                <span>Version</span>
                <strong>@ViewModel.Entry.FormVersionId</strong>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(ViewModel.HistoricalRenderWarning))
        {
            <section class="info-card">
                <strong>Historical render warning</strong>
                <p>@ViewModel.HistoricalRenderWarning</p>
            </section>
        }

        <DynamicFormRenderer Definition="ViewModel.Definition" Answers="ReadOnlyAnswers" ReadOnly="true" />

        @if (ViewModel.Entry.Files.Count > 0)
        {
            <section class="info-card">
                <h2>Stored files metadata</h2>
                @foreach (var file in ViewModel.Entry.Files)
                {
                    <div class="approval-row">
                        <div>
                            <strong><a href="@BuildDownloadUrl(file.Id)">@file.FileName</a></strong>
                            <div>@file.ContentType</div>
                        </div>
                        <div>@file.Length bytes</div>
                    </div>
                }
            </section>
        }

        @if (ViewModel.Entry.ApprovalSteps.Count > 0)
        {
            <section class="info-card">
                <h2>Approval steps</h2>
                @foreach (var step in ViewModel.Entry.ApprovalSteps.OrderBy(x => x.Order))
                {
                    <div class="approval-row">
                        <div>
                            <strong>@step.ApproverName</strong>
                            <div>@step.ApproverEmail</div>
                        </div>
                        <div>@step.Status</div>
                    </div>
                }
            </section>
        }

        @if (ViewModel.Entry.ApprovalAuditTrail.Count > 0)
        {
            <section class="info-card">
                <h2>Approval audit trail</h2>
                @foreach (var audit in ViewModel.Entry.ApprovalAuditTrail.OrderByDescending(a => a.OccurredUtc))
                {
                    <div class="approval-row">
                        <div>
                            <strong>@audit.Action</strong>
                            <div>@audit.ActorDisplayName · @audit.OccurredUtc.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)</div>
                            @if (!string.IsNullOrWhiteSpace(audit.Reason))
                            {
                                <div>Reason: @audit.Reason</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(audit.Signature))
                            {
                                <div>Signature: @audit.Signature</div>
                            }
                        </div>
                    </div>
                }
            </section>
        }
    </article>
}

@code {
    [Parameter] public Guid EntryId { get; set; }

    private bool IsLoaded { get; set; }
    private EntryDetailViewModel? ViewModel { get; set; }
    private Dictionary<string, string?> ReadOnlyAnswers { get; } = new(StringComparer.OrdinalIgnoreCase);
    private bool IsPdfLoading { get; set; }
    private string PdfStatusMessage { get; set; } = string.Empty;

    private string BuildDownloadUrl(Guid fileId)
    {
        var token = DownloadTokenService.Create(EntryId, fileId, TimeSpan.FromMinutes(10));
        return $"/entry-files/{EntryId}/{fileId}?token={Uri.EscapeDataString(token)}";
    }

    private string BuildPdfUrl() => $"/entry-pdf/{EntryId}";

    private async Task DownloadPdfAsync()
    {
        if (IsPdfLoading)
        {
            return;
        }

        IsPdfLoading = true;
        PdfStatusMessage = string.Empty;
        try
        {
            NavigationManager.NavigateTo(BuildPdfUrl(), forceLoad: true);
            PdfStatusMessage = L.Get("Entry.PdfDownloadStarted");
        }
        catch (Exception ex)
        {
            PdfStatusMessage = L.Format("Entry.PdfExportFailed", ex.Message);
        }
        finally
        {
            IsPdfLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoaded = false;
        ViewModel = await FormsService.GetEntryDetailAsync(EntryId);
        ReadOnlyAnswers.Clear();
        IsLoaded = true;

        if (ViewModel is null)
        {
            return;
        }

        foreach (var pair in ViewModel.Entry.Answers)
        {
            ReadOnlyAnswers[pair.Key] = pair.Value;
        }
    }
}
