@page "/"
@inject FormsApplicationService FormsService

<PageTitle>BlazorWebForms</PageTitle>

@if (Dashboard is null)
{
    <p>Loading...</p>
}
else
{
    <section class="hero-shell">
        <div class="hero-copy">
            <p class="eyebrow">Dynamic forms package for Blazor</p>
            <h1>Build, publish, submit, revise, approve, and audit with SQL-backed history.</h1>
            <p class="hero-text">
                Interactive Blazor sample app now runs on EF Core + SQL persistence with immutable versions,
                historical entry rendering, indexed admin queries, file metadata tracking, and workflow auditing.
            </p>
            <div class="hero-actions">
                <a class="hero-button hero-button-primary" href="/builder">Open builder</a>
                <a class="hero-button" href="/admin">View admin dashboard</a>
            </div>
        </div>
        <div class="hero-side">
            <div class="metric-card">
                <span>Forms</span>
                <strong>@Dashboard.Forms.Count</strong>
            </div>
            <div class="metric-card">
                <span>Recent entries</span>
                <strong>@Dashboard.RecentEntries.Count</strong>
            </div>
            <div class="metric-card">
                <span>Needs approval</span>
                <strong>@Dashboard.RecentEntries.Count(entry => entry.Status == EntryStatus.NeedsApproval)</strong>
            </div>
            <div class="metric-card">
                <span>Demo route</span>
                <strong>/forms/expense-approval</strong>
            </div>
        </div>
    </section>

    @if (!Dashboard.CurrentUser.IsAuthenticated)
    {
        <section class="bwf-panel">
            <p class="bwf-kicker">Authentication required</p>
            <h2>Sign in to use builder, admin, and published form routes</h2>
            <p class="bwf-help">Use the dev login controls in the top-right app bar to sign in with a sample role.</p>
        </section>
    }

    <section class="bwf-panel">
        <p class="bwf-kicker">Milestone 1 implemented</p>
        <h2>What this sample demonstrates right now</h2>
        <ul class="feature-list">
            <li>EF Core migrations + SQL Server/Azure SQL persistence for forms, entries, versions, approvals, files, and search index.</li>
            <li>Immutable publish snapshots with entry details rendered from the exact submitted version.</li>
            <li>Admin query filters by status, indexed fields, and text search (server-side query path).</li>
            <li>Submission revisions and approval progression stored as auditable history.</li>
            <li>File uploads written to storage with entry-linked metadata persisted in SQL.</li>
        </ul>
    </section>

    <section class="info-grid">
        @foreach (var form in Dashboard.Forms)
        {
            <article class="info-card">
                <p class="eyebrow">@form.Publication.AccessMode</p>
                <h2>@form.Name</h2>
                <p>@form.Description</p>
                <div class="info-actions">
                    <a href="/builder/@form.Id">Edit draft</a>
                    <a href="/forms/@form.Publication.Slug">Open published</a>
                </div>
            </article>
        }
    </section>
}

@code {
    private DashboardViewModel? Dashboard { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await FormsService.GetDashboardAsync();
    }
}
