@page "/"
@inject FormsApplicationService FormsService

<PageTitle>BlazorWebForms</PageTitle>

@if (Dashboard is null)
{
    <p>Loading...</p>
}
else
{
    <section class="hero-shell">
        <div class="hero-copy">
            <p class="eyebrow">Dynamic forms package for Blazor</p>
            <h1>Build, publish, submit, revise, approve, and audit with SQL-backed history.</h1>
            <p class="hero-text">
                Interactive Blazor sample app now runs on EF Core + SQL persistence with immutable versions,
                historical entry rendering, indexed admin queries, file metadata tracking, and workflow auditing.
            </p>
            <div class="hero-actions">
                <a class="hero-button hero-button-primary" href="/builder">Open builder</a>
                <a class="hero-button" href="/admin">View admin dashboard</a>
            </div>
        </div>
        <div class="hero-side">
            <div class="metric-card" aria-label="Total forms metric">
                <span>Forms</span>
                <strong>@Dashboard.Forms.Count</strong>
            </div>
            <div class="metric-card" aria-label="Recent entries metric">
                <span>Recent entries</span>
                <strong>@Dashboard.RecentEntries.Count</strong>
            </div>
            <div class="metric-card" aria-label="Needs approval metric">
                <span>Needs approval</span>
                <strong>@Dashboard.RecentEntries.Count(entry => entry.Status == EntryStatus.NeedsApproval)</strong>
            </div>
            <div class="metric-card" aria-label="Rejected entries metric">
                <span>Rejected</span>
                <strong>@Dashboard.RecentEntries.Count(entry => entry.Status == EntryStatus.Rejected)</strong>
            </div>
            <div class="metric-card" aria-label="Draft entries metric">
                <span>Draft</span>
                <strong>@Dashboard.RecentEntries.Count(entry => entry.Status == EntryStatus.Draft)</strong>
            </div>
            <div class="metric-card" aria-label="Demo route metric">
                <span>Demo route</span>
                <strong>/forms/expense-approval</strong>
            </div>
        </div>
    </section>

    @if (!Dashboard.CurrentUser.IsAuthenticated)
    {
        <section class="bwf-panel">
            <p class="bwf-kicker">Authentication required</p>
            <h2>Sign in to use builder, admin, and published form routes</h2>
            <p class="bwf-help">Use the dev login controls in the top-right app bar to sign in with a sample role.</p>
        </section>
    }

    <section class="bwf-panel">
        <p class="bwf-kicker">Milestones 2-6 implemented</p>
        <h2>What this sample demonstrates now</h2>
        <ul class="feature-list">
            <li>Claims-based auth + policy-guarded routes with role-based builder/admin access and submitter/self-view rules.</li>
            <li>Builder supports structured conditions, layout hints, localization maps, and branding tokens with publish-time validation.</li>
            <li>Submission workflow supports draft save/resume/finalize, immutable revisions, rejection/resubmission, reminders, and audit trail.</li>
            <li>Files pipeline supports per-field constraints, multi-file uploads, signed downloads, and persisted hash/uploader/revision metadata.</li>
            <li>Entry PDF export includes localized form content, files, approval steps, and approval audit details.</li>
            <li>Email strategy supports dry-run/SMTP/SendGrid/Graph with retry, idempotency, and anti-abuse checks.</li>
            <li>Accessibility and i18n include semantic ARIA wiring, keyboard/focus improvements, culture switch, and RTL-aware rendering.</li>
            <li>Polish/performance includes paged admin queries, metadata caching, responsive states, timeout guardrails, and regression checks.</li>
        </ul>
    </section>

    <section class="info-grid">
        @foreach (var form in Dashboard.Forms)
        {
            <article class="info-card">
                <p class="eyebrow">@form.Publication.AccessMode</p>
                <h2>@form.Name</h2>
                <p>@form.Description</p>
                <div class="info-actions">
                    <a href="/builder/@form.Id">Edit draft</a>
                    <a href="/forms/@form.Publication.Slug">Open published</a>
                </div>
            </article>
        }
    </section>
}

@code {
    private DashboardViewModel? Dashboard { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await FormsService.GetDashboardAsync();
    }
}
