@inject FormsApplicationService FormsService

@if (Dashboard is null)
{
    <p>Loading admin dashboard...</p>
}
else
{
    <div class="bwf-admin">
        <section class="bwf-panel">
            <p class="bwf-kicker">Admin console</p>
            <h2>Forms</h2>
            <div class="bwf-card-grid">
                @foreach (var form in Dashboard.Forms)
                {
                    <article class="bwf-admin-card">
                        <p class="bwf-kicker">@form.Publication.AccessMode</p>
                        <h3>@form.Name</h3>
                        <p>@form.Description</p>
                        <div class="bwf-meta-stack">
                            <span>Versions: @form.Versions.Count</span>
                            <span>Slug: /forms/@form.Publication.Slug</span>
                        </div>
                        <div class="bwf-actions">
                            <a class="bwf-link-button" href="/builder/@form.Id">Builder</a>
                            <a class="bwf-link-button" href="/forms/@form.Publication.Slug">Published</a>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="bwf-panel">
            <div class="bwf-section-toolbar">
                <div>
                    <p class="bwf-kicker">Response tracking</p>
                    <h2>Entries</h2>
                </div>
                <input class="bwf-input" value="@Search" @oninput="OnSearchChanged" placeholder="Search submitter or indexed values" />
            </div>
            <div class="bwf-grid">
                <select class="bwf-input" @bind="StatusFilter" @bind:after="LoadEntriesAsync">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<EntryStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <input class="bwf-input" @bind="IndexedFieldId" @bind:after="LoadEntriesAsync" placeholder="Indexed field id (optional)" />
                <input class="bwf-input" @bind="IndexedFieldValue" @bind:after="LoadEntriesAsync" placeholder="Indexed field value (optional)" />
            </div>
            <table class="bwf-table">
                <thead>
                    <tr>
                        <th>Submitter</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Version</th>
                        <th>Files</th>
                        <th>Search index</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Entries)
                    {
                        <tr>
                            <td><a href="/entries/@entry.Id">@entry.SubmittedBy</a></td>
                            <td>@entry.Status</td>
                            <td>@entry.SubmittedUtc.LocalDateTime</td>
                            <td>@entry.FormVersionId</td>
                            <td>@entry.Files.Count</td>
                            <td>@string.Join(", ", entry.SearchIndex.Select(x => $"{x.Key}:{x.Value}"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Entries.Count == 0)
            {
                <p class="bwf-help">No entries match the current filter set.</p>
            }
        </section>
    </div>
}

@code {
    private DashboardViewModel? Dashboard { get; set; }
    private string Search { get; set; } = string.Empty;
    private EntryStatus? StatusFilter { get; set; }
    private string IndexedFieldId { get; set; } = string.Empty;
    private string IndexedFieldValue { get; set; } = string.Empty;
    private List<EntryRecord> Entries { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await FormsService.GetDashboardAsync();
        await LoadEntriesAsync();
    }

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        Search = args.Value?.ToString() ?? string.Empty;
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        if (Dashboard is null)
        {
            return;
        }

        var options = new EntryQueryOptions
        {
            Search = Search,
            Status = StatusFilter,
            IndexedFieldId = IndexedFieldId,
            IndexedFieldValue = IndexedFieldValue
        };

        Entries = (await FormsService.QueryEntriesAsync(options)).ToList();
    }
}
