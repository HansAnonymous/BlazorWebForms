<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet Package Metadata -->
    <PackageId>BlazorWebForms.Blazor</PackageId>
    <Version>1.0.0</Version>
    <Authors>HansAnonymous</Authors>
    <Company>HansAnonymous</Company>
    <Description>Blazor components and utilities for BlazorWebForms - Build Blazor applications with WebForms-like patterns.</Description>
    <PackageTags>blazor;webforms;aspnet;components;razor</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HansAnonymous/BlazorWebForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HansAnonymous/BlazorWebForms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorWebForms.Core\BlazorWebForms.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\" />
  </ItemGroup>
</Project>
