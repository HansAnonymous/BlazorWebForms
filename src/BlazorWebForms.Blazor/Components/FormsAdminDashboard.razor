@using BlazorWebForms.Core.Services
@inject FormsApplicationService FormsService

@if (Dashboard is null)
{
    <p>Loading admin dashboard...</p>
}
else
{
    <div class="bwf-admin">
        <section class="bwf-panel">
            <h2>Forms</h2>
            <div class="bwf-card-grid">
                @foreach (var form in Dashboard.Forms)
                {
                    <article class="bwf-admin-card">
                        <p class="bwf-kicker">@form.Publication.AccessMode</p>
                        <h3>@form.Name</h3>
                        <p>@form.Description</p>
                        <div class="bwf-meta-stack">
                            <span>Versions: @form.Versions.Count</span>
                            <span>Slug: /forms/@form.Publication.Slug</span>
                        </div>
                        <div class="bwf-actions">
                            <a class="bwf-link-button" href="/builder/@form.Id">Builder</a>
                            <a class="bwf-link-button" href="/forms/@form.Publication.Slug">Published</a>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="bwf-panel">
            <div class="bwf-section-toolbar">
                <h2>Entries</h2>
                <input class="bwf-input" @bind="Search" @bind:event="onchange" @bind:after="ReloadFromFirstPageAsync" placeholder="Search submitter or indexed values" />
            </div>
            <div class="bwf-grid">
                <select class="bwf-input" @bind="StatusFilter" @bind:after="ReloadFromFirstPageAsync">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<EntryStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <input class="bwf-input" @bind="IndexedFieldId" @bind:after="ReloadFromFirstPageAsync" placeholder="Indexed field id (optional)" />
                <input class="bwf-input" @bind="IndexedFieldValue" @bind:after="ReloadFromFirstPageAsync" placeholder="Indexed field value (optional)" />
                <select class="bwf-input" @bind="AuditActionFilter" @bind:after="ReloadFromFirstPageAsync">
                    <option value="">All audit actions</option>
                    @foreach (var action in Enum.GetValues<ApprovalAuditAction>())
                    {
                        <option value="@action">@action</option>
                    }
                </select>
            </div>
            <div class="bwf-table-wrap" role="region" aria-label="Entries table" tabindex="0">
                <table class="bwf-table">
                    <thead>
                        <tr>
                            <th scope="col">Submitter</th>
                            <th scope="col">Status</th>
                            <th scope="col">Submitted</th>
                            <th scope="col">Search index</th>
                            <th scope="col">Audit events</th>
                            <th scope="col">Notification status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Entries)
                        {
                            <tr>
                                <td><a href="/entries/@entry.Id">@entry.SubmittedBy</a></td>
                                <td>@entry.Status</td>
                                <td>@entry.SubmittedUtc.LocalDateTime</td>
                                <td>@string.Join(", ", entry.SearchIndex.Select(x => $"{x.Key}:{x.Value}"))</td>
                                <td>@entry.ApprovalAuditTrail.Count</td>
                                <td>@GetNotificationStatus(entry)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="bwf-actions">
                <button class="bwf-button" @onclick="PreviousPageAsync" disabled="@(Page == 1)">Previous</button>
                <span class="bwf-help">Page @Page</span>
                <button class="bwf-button" @onclick="NextPageAsync" disabled="@(!HasMore)">Next</button>
            </div>
        </section>
    </div>
}

@code {
    private DashboardViewModel? Dashboard { get; set; }
    private string Search { get; set; } = string.Empty;
    private EntryStatus? StatusFilter { get; set; }
    private string IndexedFieldId { get; set; } = string.Empty;
    private string IndexedFieldValue { get; set; } = string.Empty;
    private ApprovalAuditAction? AuditActionFilter { get; set; }
    private List<EntryRecord> Entries { get; set; } = [];
    private int Page { get; set; } = 1;
    private const int PageSize = 50;
    private bool HasMore { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Dashboard = await FormsService.GetDashboardAsync();
        await LoadEntriesAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (Page <= 1)
        {
            return;
        }

        Page--;
        await LoadEntriesAsync();
    }

    private async Task ReloadFromFirstPageAsync()
    {
        Page = 1;
        await LoadEntriesAsync();
    }

    private async Task NextPageAsync()
    {
        if (!HasMore)
        {
            return;
        }

        Page++;
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        if (Dashboard is null)
        {
            return;
        }

        var options = new EntryQueryOptions
        {
            Search = Search,
            Status = StatusFilter,
            IndexedFieldId = IndexedFieldId,
            IndexedFieldValue = IndexedFieldValue,
            Offset = (Page - 1) * PageSize,
            Limit = PageSize + 1
        };

        var results = (await FormsService.QueryEntriesAsync(options)).ToList();
        HasMore = results.Count > PageSize;
        if (HasMore)
        {
            results = results.Take(PageSize).ToList();
        }

        Entries = results;

        if (AuditActionFilter.HasValue)
        {
            Entries = Entries
                .Where(e => e.ApprovalAuditTrail.Any(a => a.Action == AuditActionFilter.Value))
                .ToList();
        }

        Entries = Entries
            .OrderByDescending(e => e.ApprovalAuditTrail.Any() ? e.ApprovalAuditTrail.Max(a => a.OccurredUtc) : e.SubmittedUtc)
            .ThenByDescending(e => e.SubmittedUtc)
            .ToList();
    }

    private static string GetNotificationStatus(EntryRecord entry)
    {
        if (entry.Status == EntryStatus.Approved)
        {
            return "Approval delivered";
        }

        if (entry.Status == EntryStatus.Rejected)
        {
            return "Rejection delivered";
        }

        if (entry.Status == EntryStatus.NeedsApproval)
        {
            return "Awaiting approver";
        }

        return "Not sent";
    }
}
