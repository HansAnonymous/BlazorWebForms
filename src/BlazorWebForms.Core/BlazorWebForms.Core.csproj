<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet Package Metadata -->
    <PackageId>BlazorWebForms.Core</PackageId>
    <Version>1.0.3</Version>
    <Authors>HansAnonymous</Authors>
    <Company>HansAnonymous</Company>
    <Description>Core library for BlazorWebForms - A library for building Blazor applications with WebForms-like patterns.</Description>
    <PackageTags>blazor;webforms;aspnet;core</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HansAnonymous/BlazorWebForms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HansAnonymous/BlazorWebForms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="TECHNICAL_REFERENCE.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
